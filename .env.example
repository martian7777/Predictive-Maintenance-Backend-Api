# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Predictive Maintenance API"
ENVIRONMENT=development          # development | testing | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=7860
# Base URL the Gradio frontend uses to reach the API.
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=pmuser
POSTGRES_PASSWORD=pmpassword
POSTGRES_DB=predictive_maintenance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async DSN. If unset it is assembled from the parts above.
# DATABASE_URL=postgresql+asyncpg://pmuser:pmpassword@localhost:5432/predictive_maintenance

# ---------------------------------------------------------------------------
# Security / JWT
# ---------------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# OpenRouter / AI
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=                # leave empty to use the built-in mock explainer
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-pro
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Telemetry / Anomaly detection
# ---------------------------------------------------------------------------
CSV_CHUNK_SIZE=50000               # rows per processing chunk
ISOLATION_FOREST_CONTAMINATION=0.02
ISOLATION_FOREST_N_ESTIMATORS=100
MODEL_DIR=./models                 # where trained detectors are persisted
